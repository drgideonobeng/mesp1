// =============================================================================
// phase3a/nextflow.config — Integration Atlas Pipeline
// Project : Mesp1
// Author  : Gideon Obeng
// Version : 1.0.0
// =============================================================================

manifest {
    name            = 'mesp1-scRNAseq-phase3a'
    author          = 'Gideon Obeng'
    description     = 'Phase 3a: fastMNN integration atlas for Mesp1-cardiopharyngeal lineage'
    version         = '1.0.0'
    nextflowVersion = '>=26.04.0'
}

// =============================================================================
// 1. PARAMETERS
// =============================================================================

params {

    // -------------------------------------------------------------------------
    // Input: Phase 1 filtered objects (04_seurat_filtered.rds per timepoint)
    // -------------------------------------------------------------------------
    filtered_e80  = null
    filtered_e825 = null
    filtered_e95  = null
    filtered_e105 = null

    // -------------------------------------------------------------------------
    // Project Infrastructure
    // -------------------------------------------------------------------------
    project_name   = "Mesp1_Integrated"
    resultsdir     = "${projectDir}/../results/integrated"
    cluster_labels = "${projectDir}/cluster_labels_atlas.csv"
    cleanup_work   = false

    // -------------------------------------------------------------------------
    // Integration Parameters
    // -------------------------------------------------------------------------
    n_features = 3000   // Shared variable features selected for fastMNN
    mnn_k      = 20     // Mutual nearest neighbours per cell in fastMNN

    // -------------------------------------------------------------------------
    // Dimensionality Reduction & Clustering
    // -------------------------------------------------------------------------
    mnn_dims    = 30    // MNN corrected dims used for UMAP and graph construction
    cluster_res = 0.4   // Louvain resolution (validate with clustree output)
}

// =============================================================================
// 2. PROCESS DEFAULTS
// =============================================================================

process {
    debug         = true
    beforeScript  = 'export R_MAX_VSIZE=32Gb'
    cpus          = 2
    memory        = '8 GB'
    time          = '1 h'
    errorStrategy = 'finish'
    maxRetries    = 2
}

// =============================================================================
// 3. EXECUTION PROFILES
// =============================================================================

profiles {

    standard {
        process.executor = 'local'
    }

    conda {
        process.conda  = "${projectDir}/../env.yml"
        conda.enabled  = true
        conda.cacheDir = "${System.getProperty('user.home')}/.conda/nextflow-envs"
    }

    // Apple Silicon (M-series Mac, 32 GB+ unified memory)
    // PREP_NORMALIZE maxForks 2: runs two samples at a time to stay in budget.
    apple_silicon {
        process {
            withName: 'PREP_NORMALIZE' {
                cpus     = 4
                memory   = { 16.GB * task.attempt }
                time     = '2 h'
                maxForks = 2
            }
            withName: 'INTEGRATE_FASTMNN' {
                cpus   = 8
                memory = { 48.GB * task.attempt }
                time   = '3 h'
            }
            withName: 'ANNOTATE_ATLAS' {
                cpus   = 8
                memory = { 32.GB * task.attempt }
                time   = '2 h'
            }
        }
    }

    // Standard laptop/desktop (8–16 GB RAM)
    // PREP_NORMALIZE maxForks 1: sequential normalization to avoid OOM.
    low_mem {
        process {
            withName: 'PREP_NORMALIZE' {
                cpus     = 4
                memory   = { 8.GB * task.attempt }
                time     = '4 h'
                maxForks = 1
            }
            withName: 'INTEGRATE_FASTMNN' {
                cpus   = 4
                memory = { 16.GB * task.attempt }
                time   = '6 h'
            }
            withName: 'ANNOTATE_ATLAS' {
                cpus   = 4
                memory = { 8.GB * task.attempt }
                time   = '4 h'
            }
        }
    }

    // HPC cluster (SLURM) — all 4 PREP_NORMALIZE jobs run in parallel
    hpc {
        process.executor = 'slurm'
        process {
            withName: 'PREP_NORMALIZE' {
                cpus   = 8
                memory = { 32.GB * task.attempt }
                time   = '2 h'
                queue  = 'highmem'
            }
            withName: 'INTEGRATE_FASTMNN' {
                cpus   = 16
                memory = { 96.GB * task.attempt }
                time   = '4 h'
                queue  = 'highmem'
            }
            withName: 'ANNOTATE_ATLAS' {
                cpus   = 16
                memory = { 64.GB * task.attempt }
                time   = '4 h'
                queue  = 'highmem'
            }
        }
    }

    docker {
        docker.enabled    = true
        process.container = 'satijalab/seurat:latest'
    }
}

// =============================================================================
// 4. PIPELINE OBSERVABILITY
// Prefixed "phase3a_" so reports coexist with Phase 1/2 in pipeline_info/
// =============================================================================

timeline {
    enabled   = true
    file      = "${params.resultsdir}/pipeline_info/phase3a_timeline.html"
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.resultsdir}/pipeline_info/phase3a_report.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.resultsdir}/pipeline_info/phase3a_trace.txt"
    overwrite = true
}

dag {
    enabled   = true
    file      = "${params.resultsdir}/pipeline_info/phase3a_flowchart.html"
    overwrite = true
}

// =============================================================================
// 5. WORK DIRECTORY CLEANUP
// =============================================================================

cleanup = params.cleanup_work
